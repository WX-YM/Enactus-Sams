# Build trees, one per preset.
/build/

# vcpkg installs into the build tree, but a manual configure can drop these here.
/vcpkg_installed/
/.vcpkg-root

# Generated by CMAKE_EXPORT_COMPILE_COMMANDS; the real one lives in build/<preset>/.
/compile_commands.json

# Editor and tooling scratch.
/.cache/
/.idea/
/.vscode/
*.swp

# CTest leftovers.
/Testing/

# Where tools/release-artefacts.sh writes the two files a release publishes.
# They are derived from the tables in this repository, so committing one would be
# committing a copy of something the build already produces — and the copy is the
# one that goes stale.
/dist/
