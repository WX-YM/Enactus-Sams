{
    "name": "hammer",
    "version": "0.1.0",
    "private": true,
    "description": "The browser half of an anvil application: transport, state and unstyled components, with zero runtime dependencies.",
    "license": "UNLICENSED",
    "type": "module",
    "sideEffects": false,
    "engines": {
        "node": ">=22"
    },
    "exports": {
        ".": "./dist/core/index.js",
        "./wire": "./dist/wire/index.js",
        "./state": "./dist/state/index.js",
        "./dom": "./dist/dom/index.js",
        "./crypto": "./dist/crypto/index.js",
        "./prehash": "./dist/prehash/index.js",
        "./prehash-worker": "./dist/prehash/worker.js",
        "./accounts": "./dist/accounts/index.js",
        "./chart": "./dist/chart/index.js",
        "./edit": "./dist/edit/index.js",
        "./react": "./dist/react/index.js",
        "./codegen": "./dist/codegen/cli.js"
    },
    "bin": {
        "hammer": "./dist/codegen/cli.js"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "build": "tsc -p tsconfig.build.json",
        "test": "node --import ./tests/support/register.mjs --test 'tests/chart/scale.test.ts' 'tests/chat/**/*.test.ts' 'tests/chat-e2ee/vault.test.ts' 'tests/chat-e2ee/device_keys.test.ts' 'tests/chat-e2ee/link.test.ts' 'tests/codegen/**/*.test.ts' 'tests/contract/**/*.test.ts' 'tests/core/**/*.test.ts' 'tests/crypto/**/*.test.ts' 'tests/edit/recipe.test.ts' 'tests/edit/geometry.test.ts' 'tests/edit/history.test.ts' 'tests/edit/submit.test.ts' 'tests/edit/parity.test.ts' 'tests/prehash/**/*.test.ts' 'tests/accounts/**/*.test.ts' 'tests/dom/bundle.test.ts' 'tests/dom/in_browser.test.ts' 'tests/react/boundary.test.ts' 'tests/state/**/*.test.ts' 'tests/support/**/*.test.ts' 'tests/wire/**/*.test.ts'",
        "test:live": "node --import ./tests/support/register.mjs --test --test-concurrency=1 --test-timeout=30000 'tests/live/**/*.test.ts'",
        "test:browser": "node --import ./tests/support/register.mjs --test --test-concurrency=1 --test-timeout=60000 'tests/browser/**/*.test.ts'",
        "check": "npm run typecheck && npm run test && npm run lint",
        "lint": "tools/check-source-bans.sh && tools/check-wire-discipline.sh && tools/check-vocabulary.sh && tools/check-layering.sh && tools/check-dependencies.sh && tools/check-descriptor.sh && tools/check-docs.sh && tools/check-bundle-budget.sh && tools/check-build-output.sh && tools/check-public-surface.sh && tools/check-surface-coverage.sh",
        "check:production": "npm run check && tools/check-dependencies.sh --production && tools/check-audit.sh --production"
    },
    "dependencies": {},
    "peerDependencies": {
        "react": ">=18"
    },
    "peerDependenciesMeta": {
        "react": {
            "optional": true
        }
    },
    "devDependencies": {
        "@types/node": "22.20.2",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "esbuild": "0.28.2",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "typescript": "5.9.3"
    }
}
