; Zero runtime dependencies is a security control, and this is the other half
; of it (CLAUDE.md §12.2, §5): a devDependency that never runs its install
; script cannot use one to reach into this machine's filesystem or credentials
; during `npm ci`. `tools/check-dependencies.sh` errors if this line is ever
; removed. esbuild's platform binary still works: it ships as an optional
; @esbuild/<platform> dependency rather than something the disabled script
; would have had to fetch.
ignore-scripts=true

; A caret or tilde spec is a version this repository never reviewed yet. Every
; devDependency is pinned exactly, and this makes a stray range a failure at
; install time rather than something only `tools/check-dependencies.sh` catches
; on the next run.
save-exact=true

; `engines.node` in package.json is a claim; this is what enforces it locally,
; the same way CI's `actions/setup-node` enforces it there.
engine-strict=true

; No output has a reason to exist in this repository's own CI logs, and it is
; one fewer network call `npm ci` makes on a machine that may have none.
fund=false
